{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "0.0.0.0",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy-out",
      "server": "代理IP",
      "server_port": 443,
      "uuid": "自行填入",
      "tls": {
        "enabled": true,
        "server_name": "自行填入"
      },
      "transport": {
        "type": "ws",
        "path": "/",
        "headers": {
          "Host": "自行填入"
        }
      }
    }
  ],
  "route": {
    "final": "proxy-out"
  }
}

# =========================
# Telegram API
# =========================
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=/data/accounts/default
TG_SESSION_DIR=/data/accounts
TG_CONNECT_TIMEOUT=60

# =========================
# Proxy (optional)
# =========================
TG_PROXY_ENABLED=false
TG_PROXY_PLUGIN=socks5
TG_PROXY_HOST=proxy
TG_PROXY_PORT=1080
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# =========================
# PostgreSQL
# =========================
POSTGRES_PASSWORD=tgdrive
DATABASE_URL=postgresql://tgdrive:tgdrive@postgres:5432/tgdrive

# =========================
# Authentication
# =========================
AUTH_SECRET=replace-with-a-random-secret
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_TTL=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# =========================
# Server
# =========================
PORT=8000

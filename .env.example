# =========================
# Telegram API
# =========================
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_DIR=/data/accounts
TG_CONNECT_TIMEOUT=60

# =========================
# Optional Telegram proxy endpoint (proxy service is a separate image)
# =========================
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=proxy
TG_PROXY_PORT=1080
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

TG_PROXY_UPSTREAM_TYPE=vless
TG_PROXY_VLESS_SERVER=
TG_PROXY_VLESS_PORT=443
TG_PROXY_VLESS_UUID=
TG_PROXY_VLESS_SERVER_NAME=
TG_PROXY_VLESS_WS_PATH=/
TG_PROXY_VLESS_WS_HOST=

# =========================
# PostgreSQL
# =========================
# Set a strong, URL-safe password and use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=

# =========================
# Authentication
# =========================
AUTH_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_TTL=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# =========================
# Server
# =========================
PORT=8000

# Maximum simultaneous download streams per Core process
TGDRIVE_MAX_CONCURRENT_DOWNLOADS=8
